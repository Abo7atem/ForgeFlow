<Window x:Class="ForgeFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeFlow"
        Icon="Assets/ForgeFlow.ico"
        Width="900" Height="630"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Window.Resources>
        <!-- SF Pro / Apple font stack -->
        <FontFamily x:Key="AppleFont">Segoe UI, SF Pro Display, -apple-system, BlinkMacSystemFont, Helvetica Neue, sans-serif</FontFamily>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#F5F5F7"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Dark Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#48484A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Button (Blue accent) -->
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="BorderBrush" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0071E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005BBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="#D1D1D6"/>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="VideoProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Track -->
                            <Border Background="#2C2C2E" CornerRadius="3"/>
                            <!-- Fill -->
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#2C2C2E"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0A84FF" Offset="0"/>
                                        <GradientStop Color="#30D158" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBEBF5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="8,4"
                                                                  VerticalAlignment="Center"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#8E8E93"
                                                      StrokeThickness="1.5"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,4,28,4"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2C2C2E"
                                            BorderBrush="#3A3A3C"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer>
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar">
                                                    <Setter Property="Background" Value="#1C1C1E"/>
                                                    <Setter Property="Width" Value="6"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ScrollBar">
                                                                <Border Background="#1C1C1E" CornerRadius="3" Width="6">
                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                        <Track.Thumb>
                                                                            <Thumb>
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border Background="#48484A" CornerRadius="3"/>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                    </Track>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ScrollViewer.Resources>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="3,1">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/ForgeFlowMark.png"
                   Grid.Column="0"
                   Width="96"
                   Height="58"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ForgeFlow"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#F5F5F7"/>
                <TextBlock Text="Video 60FPS + TikTok30FPS"
                           Foreground="#8E8E93"
                           FontSize="12"
                           Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="LicenseStatusTextBlock"
                           Text="Checking license..."
                           Foreground="#8E8E93"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Right"/>
                <TextBlock x:Name="VersionTextBlock"
                           Text="v..."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextAlignment="Right"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Input Row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Input"
                       VerticalAlignment="Center"
                       Foreground="#8E8E93"/>
            <TextBox Grid.Column="1" x:Name="InputTextBox" Height="34"
                     ToolTip="Drop a video here or anywhere in the ForgeFlow window."/>
            <Button Grid.Column="3" Content="Browse"
                    Height="34" Click="BrowseInput_Click"/>
        </Grid>

        <!-- Output Row -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output"
                       VerticalAlignment="Center"
                       Foreground="#8E8E93"/>
            <TextBox Grid.Column="1" x:Name="OutputTextBox" Height="34"
                     ToolTip="ForgeFlow will create two files beside this path: *_Video 60FPS.mp4 and *_TikTok30FPS.mp4"/>
            <Button Grid.Column="3" Content="Browse"
                    Height="34" Click="BrowseOutput_Click"/>
        </Grid>

        <Grid Grid.Row="5" Margin="110,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="ToolsStatusTextBlock"
                           Text="Checking tools..."
                           Foreground="#6E6E73"
                           FontSize="11"/>
                <TextBlock x:Name="VideoInfoTextBlock"
                           Text="Original size preserved | RIFE v4.26 | Two outputs only"
                           Foreground="#6E6E73"
                           FontSize="11"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="EstimateTextBlock"
                           Text=""
                           Foreground="#6E6E73"
                           FontSize="11"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="OutputPreviewTextBlock"
                           Text="Select a video to preview the two customer-ready exports."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="PresetInsightTextBlock"
                           Text="Balanced keeps a practical mix of quality, size, and processing time."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Content="Test Tools"
                        Height="26"
                        MinWidth="82"
                        Padding="10,0"
                        FontSize="11"
                        Margin="8,0,0,0"
                        Click="TestToolsButton_Click"/>
                <ComboBox x:Name="PresetComboBox"
                          Width="92"
                          Height="26"
                          FontSize="11"
                          Margin="6,0,0,0"
                          SelectionChanged="PresetComboBox_SelectionChanged"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Fast"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Quality"/>
                </ComboBox>
                <Button Content="About"
                        Height="26"
                        MinWidth="64"
                        Padding="10,0"
                        FontSize="11"
                        Margin="6,0,0,0"
                        Click="AboutButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Log Box -->
        <Border Grid.Row="6"
                Background="#1C1C1E"
                BorderBrush="#3A3A3C"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <TextBox x:Name="LogsTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontFamily="Menlo, Consolas, monospace"
                         FontSize="12"
                         Foreground="#98989D"
                         Padding="12,10"
                         Margin="0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0">
                    <Button Content="Open Folder"
                            Height="26"
                            MinWidth="92"
                            Padding="10,0"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="OpenOutputFolderButton_Click"/>
                    <Button Content="Copy Log"
                            Height="26"
                            MinWidth="78"
                            Padding="10,0"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="CopyLogButton_Click"/>
                    <Button Content="Clear"
                            Height="26"
                            MinWidth="64"
                            Padding="10,0"
                            FontSize="11"
                            Click="ClearLogButton_Click"/>
                </StackPanel>

                <Border x:Name="DropOverlay"
                        Visibility="Collapsed"
                        Background="#CC101014"
                        BorderBrush="#0A84FF"
                        BorderThickness="2"
                        CornerRadius="10"
                        Margin="10">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Drop video to ForgeFlow"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Output will be created beside the original video."
                                   Foreground="#A0A0A6"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Label row: Stage + Percent -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="StageLabel"
                           Text="Ready"
                           Foreground="#8E8E93"
                           FontSize="12"/>
                <TextBlock x:Name="PercentLabel"
                           Text="0%"
                           Foreground="#8E8E93"
                           FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Progress Line -->
            <ProgressBar Grid.Row="1"
                         x:Name="MainProgressBar"
                         Style="{StaticResource VideoProgressStyle}"
                         VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="0"/>

            <Canvas x:Name="ProgressMoodTrack"
                    Grid.Row="1"
                    Height="24"
                    Margin="0,0,0,0"
                    SizeChanged="ProgressMoodTrack_SizeChanged"
                    ClipToBounds="False">
                <Border x:Name="ProgressMoodBubble"
                        Canvas.Left="0"
                        Width="42"
                        Height="24"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Grid Width="34"
                              Height="22">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="RunnerBounceTransform"/>
                            </Grid.RenderTransform>
                            <Image x:Name="RunnerIconImage"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Source="Assets/Emoji/runner.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </Image.RenderTransform>
                            </Image>
                            <Image x:Name="RunnerDashImage"
                                   Width="14"
                                   Height="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Source="Assets/Emoji/dash.png"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock x:Name="ProgressMoodText"
                                   Text="Ready"
                                   Visibility="Collapsed"
                                   Foreground="#D1D1D6"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

        <!-- Owner Rights / Social Links -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="جميع الحقوق محفوظة A.Hatem T-Zone SYR"
                           Foreground="#8E8E93"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  |  4tiko.net"
                           Foreground="#D1D1D6"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Store"
                        Tag="https://4tiko.net"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="YouTube"
                        Tag="https://youtube.com/@bo_7atemm"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="Discord"
                        Tag="https://discord.gg/jF5uNEyg8r"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="Telegram"
                        Tag="https://t.me/a_7atem"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="TikTok"
                        Tag="https://www.tiktok.com/@bo.7atem"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Buttons Row -->
        <StackPanel Grid.Row="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="StartButton"
                    Content="Start"
                    Style="{StaticResource StartButtonStyle}"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Click="StartButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>
            <Button x:Name="RetryButton"
                    Content="Retry"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="RetryButton_Click"/>
            <Button x:Name="ActivationButton"
                    Content="Activation"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Click="ActivationButton_Click"/>
            <Button x:Name="UpdateButton"
                    Content="Updates"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Click="UpdateButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
