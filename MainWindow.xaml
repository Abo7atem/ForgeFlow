<Window x:Class="ForgeFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeFlow"
        Icon="Assets/ForgeFlow.ico"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Window.Resources>
        <!-- SF Pro / Apple font stack -->
        <FontFamily x:Key="AppleFont">Segoe UI, SF Pro Display, -apple-system, BlinkMacSystemFont, Helvetica Neue, sans-serif</FontFamily>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#F5F5F7"/>
            <Setter Property="SelectionBrush" Value="#0A84FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Dark ScrollBars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#111113"/>
            <Setter Property="Foreground" Value="#FF9F0A"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root"
                              Width="10"
                              Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#6A4420"
                                                        CornerRadius="5"
                                                        Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#FF9F0A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#FFB340"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#48484A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Button (Blue accent) -->
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="BorderBrush" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0071E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005BBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="#D1D1D6"/>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="VideoProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Track -->
                            <Border Background="#2C2C2E" CornerRadius="3"/>
                            <!-- Fill -->
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#2C2C2E"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0A84FF" Offset="0"/>
                                        <GradientStop Color="#30D158" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBEBF5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="8,4"
                                                                  VerticalAlignment="Center"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#8E8E93"
                                                      StrokeThickness="1.5"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,4,28,4"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2C2C2E"
                                            BorderBrush="#3A3A3C"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer>
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar">
                                                    <Setter Property="Background" Value="#1C1C1E"/>
                                                    <Setter Property="Width" Value="6"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ScrollBar">
                                                                <Border Background="#1C1C1E" CornerRadius="3" Width="6">
                                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                        <Track.Thumb>
                                                                            <Thumb>
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border Background="#6A4420" CornerRadius="3"/>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                    </Track>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ScrollViewer.Resources>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="3,1">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F5F5F7"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16" Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/ForgeFlowMark.png"
                   Grid.Column="0"
                   Width="96"
                   Height="58"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ForgeFlow"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#F5F5F7"/>
                <TextBlock Text="Video 60FPS + TikTok 60 Ultra + TikTok30FPS"
                           Foreground="#8E8E93"
                           FontSize="12"
                           Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Border x:Name="PlanBadgeBorder"
                        Background="#243144"
                        BorderBrush="#4A90E2"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="10,4"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="PlanBadgeTextBlock"
                               Text="TRIAL"
                               Foreground="#FFE0AD"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>
                </Border>
                <TextBlock x:Name="LicenseStatusTextBlock"
                           Text="Checking license..."
                           Foreground="#8E8E93"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="PlanDetailsTextBlock"
                           Text="3 trial attempts"
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextAlignment="Right"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="VersionTextBlock"
                           Text="v..."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextAlignment="Right"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Input Row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Input"
                       VerticalAlignment="Center"
                       Foreground="#8E8E93"/>
            <TextBox Grid.Column="1" x:Name="InputTextBox" Height="34"
                     ToolTip="Drop a video here or anywhere in the ForgeFlow window."/>
            <Button Grid.Column="3" Content="اختيار"
                    Height="34" Click="BrowseInput_Click"/>
        </Grid>

        <!-- Output Row -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output"
                       VerticalAlignment="Center"
                       Foreground="#8E8E93"/>
            <TextBox Grid.Column="1" x:Name="OutputTextBox" Height="34"
                     ToolTip="ForgeFlow creates Video 60FPS, TikTok 60 Ultra, and patched TikTok30FPS exports."/>
            <Button Grid.Column="3" Content="اختيار"
                    Height="34" Click="BrowseOutput_Click"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,4,0,6">
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="ToolsStatusTextBlock"
                           Text="Checking tools..."
                           Foreground="#6E6E73"
                           FontSize="11"/>
                <TextBlock x:Name="VideoInfoTextBlock"
                           Text="Original size preserved | RIFE v4.26 | Three optimized outputs"
                           Foreground="#6E6E73"
                           FontSize="11"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="EstimateTextBlock"
                           Text=""
                           Foreground="#6E6E73"
                           FontSize="11"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="OutputPreviewTextBlock"
                           Text="Select a video to preview the two customer-ready exports."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="PresetInsightTextBlock"
                           Text="Balanced keeps a practical mix of quality, size, and processing time."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="UpscaleInsightTextBlock"
                           Text="Quality boost is off. RIFE keeps the original resolution."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="StartHintTextBlock"
                           Text="Start is waiting for startup checks."
                           Foreground="#6E6E73"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="فحص الأدوات"
                            Height="26"
                            MinWidth="82"
                            Padding="10,0"
                            FontSize="11"
                            Margin="8,0,0,0"
                            Click="TestToolsButton_Click"/>
                    <Button x:Name="Glitch30Button"
                            Content="Glitch 30"
                            Height="26"
                            MinWidth="82"
                            Padding="10,0"
                            FontSize="11"
                            Margin="6,0,0,0"
                            Background="#D86600"
                            BorderBrush="#D86600"
                            Foreground="White"
                            ToolTip="Create a GLITCHED30.mp4 slow-motion clip with FFmpeg only."
                            Click="Glitch30Button_Click"/>
                    <Button Content="فتح محرر الفيديو"
                            Height="30" MinWidth="138" Padding="12,0" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                            Background="#176B87" BorderBrush="#2493B7" Foreground="White"
                            ToolTip="محرر متعدد المسارات للقص والصوت والنصوص والصور والمؤثرات"
                            Click="EditBeforeEnhanceButton_Click"/>
                    <ComboBox x:Name="PresetComboBox"
                              Width="110"
                              Height="26"
                              FontSize="11"
                              Margin="6,0,0,0"
                              SelectionChanged="PresetComboBox_SelectionChanged"
                              SelectedIndex="1">
                        <ComboBoxItem Content="Fast"/>
                        <ComboBoxItem Content="Balanced"/>
                        <ComboBoxItem Content="Quality"/>
                        <ComboBoxItem Content="Aesthetic Vivid"/>
                    </ComboBox>
                    <ComboBox x:Name="VisualStyleComboBox"
                              Width="116"
                              Height="26"
                              FontSize="11"
                              Margin="6,0,0,0"
                              SelectionChanged="VisualStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Natural" Tag="natural"/>
                        <ComboBoxItem Content="TikTok Vivid" Tag="tiktok-vivid"/>
                        <ComboBoxItem Content="Vivid+" Tag="tiktok-vivid-plus"/>
                    </ComboBox>
                    <Grid Width="118"
                          Height="26"
                          Margin="6,0,0,0"
                          ToolTip="Controls color, local contrast, and clean sharpening strength.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VisualStyleStrengthSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                Value="70"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="VisualStyleStrengthSlider_ValueChanged"/>
                        <TextBlock x:Name="VisualStyleStrengthTextBlock"
                                   Grid.Column="1"
                                   Text="70%"
                                   Foreground="#8E8E93"
                                   FontSize="10"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button Content="حول"
                            Height="26"
                            MinWidth="64"
                            Padding="10,0"
                            FontSize="11"
                            Margin="6,0,0,0"
                            Click="AboutButton_Click"/>
                    <Button x:Name="SupportButton"
                            Content="Activate / Buy"
                            Height="26"
                            MinWidth="102"
                            Padding="10,0"
                            FontSize="11"
                            Margin="6,0,0,0"
                            Click="SupportButton_Click"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right"
                           Margin="0,8,0,0"
                           ItemWidth="Auto"
                           Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <DockPanel LastChildFill="False"
                                   Margin="0,0,0,3">
                            <TextBlock x:Name="HardwareTitleTextBlock"
                                       Text="Hardware"
                                       Foreground="#8E8E93"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox x:Name="HardwareComboBox"
                                  Width="165"
                                  Height="30"
                                  FontSize="11"
                                  SelectionChanged="HardwareComboBox_SelectionChanged">
                            <ComboBoxItem Content="CPU" Tag="cpu"/>
                            <ComboBoxItem Content="NVIDIA NVENC/NVDEC" Tag="nvidia"/>
                            <ComboBoxItem Content="AMD AMF" Tag="amd"/>
                        </ComboBox>
                        <TextBlock x:Name="HardwareHintTextBlock"
                                   Text=""
                                   Foreground="#6E6E73"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Width="165"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="MotionTitleTextBlock"
                                   Text="Motion"
                                   HorizontalAlignment="Left"
                                   Foreground="#8E8E93"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="MotionComboBox"
                                  Width="125"
                                  Height="30"
                                  FontSize="11"
                                  SelectionChanged="MotionComboBox_SelectionChanged">
                            <ComboBoxItem Content="RIFE On" Tag="on"/>
                            <ComboBoxItem Content="RIFE Off" Tag="off"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <DockPanel LastChildFill="False"
                                   Margin="0,0,0,3">
                            <TextBlock x:Name="QualityBoostTitleTextBlock"
                                       Text="Quality Boost"
                                       Foreground="#8E8E93"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox x:Name="UpscaleComboBox"
                                  Width="190"
                                  Height="30"
                                  FontSize="11"
                                  SelectionChanged="UpscaleComboBox_SelectionChanged"/>
                        <TextBlock x:Name="QualityBoostHintTextBlock"
                                   Text=""
                                   Foreground="#6E6E73"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Width="190"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <DockPanel LastChildFill="False"
                                   Margin="0,0,0,3">
                            <TextBlock x:Name="PipelineOrderTitleTextBlock"
                                       Text="Pipeline Order"
                                       Foreground="#8E8E93"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox x:Name="ProcessingOrderComboBox"
                                  Width="185"
                                  Height="30"
                                  FontSize="11"
                                  SelectionChanged="ProcessingOrderComboBox_SelectionChanged">
                            <ComboBoxItem Content="RIFE then Upscale" Tag="rife-then-upscale"/>
                            <ComboBoxItem Content="Upscale then RIFE" Tag="upscale-then-rife"/>
                        </ComboBox>
                        <TextBlock x:Name="PipelineHintTextBlock"
                                   Text=""
                                   Foreground="#6E6E73"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Width="185"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SubjectFocusTitleTextBlock"
                                   Text="Subject Focus"
                                   HorizontalAlignment="Left"
                                   Foreground="#8E8E93"
                                   FontSize="11"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="SubjectFocusComboBox"
                                  Width="165"
                                  Height="30"
                                  FontSize="11"
                                  SelectionChanged="SubjectFocusComboBox_SelectionChanged">
                            <ComboBoxItem Content="Off" Tag="off"/>
                            <ComboBoxItem Content="Protect Edges" Tag="protect"/>
                            <ComboBoxItem Content="Enhance Subject" Tag="enhance"/>
                            <ComboBoxItem Content="Soften Background" Tag="soften-bg"/>
                        </ComboBox>
                        <Grid Width="165"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SubjectFocusStrengthSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="70"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SubjectFocusStrengthSlider_ValueChanged"/>
                            <TextBlock x:Name="SubjectFocusStrengthTextBlock"
                                       Grid.Column="1"
                                       Text="70%"
                                       Foreground="#8E8E93"
                                       FontSize="10"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="SubjectFocusHintTextBlock"
                                   Text=""
                                   Foreground="#6E6E73"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Width="165"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Activity and integrated before/after preview -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Background="#1C1C1E"
                BorderBrush="#3A3A3C"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <TextBox x:Name="LogsTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontFamily="Menlo, Consolas, monospace"
                         FontSize="12"
                         Foreground="#98989D"
                         Padding="12,10"
                         Margin="0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0">
                    <Button Content="Open Folder"
                            Height="26"
                            MinWidth="92"
                            Padding="10,0"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="OpenOutputFolderButton_Click"/>
                    <Button Content="Copy Log"
                            Height="26"
                            MinWidth="78"
                            Padding="10,0"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="CopyLogButton_Click"/>
                    <Button Content="Report Issue"
                            Height="26"
                            MinWidth="94"
                            Padding="10,0"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Click="ReportIssueButton_Click"/>
                    <Button Content="Clear"
                            Height="26"
                            MinWidth="64"
                            Padding="10,0"
                            FontSize="11"
                            Click="ClearLogButton_Click"/>
                </StackPanel>

                <Border x:Name="DropOverlay"
                        Visibility="Collapsed"
                        Background="#CC101014"
                        BorderBrush="#0A84FF"
                        BorderThickness="2"
                        CornerRadius="10"
                        Margin="10">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Drop video to ForgeFlow"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Output will be created beside the original video."
                                   Foreground="#A0A0A6"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="#111113"
                BorderBrush="#5A341C"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="قبل — الأصلي" FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93"/>
                        <TextBlock x:Name="InlinePreviewInputStatusText" Text="اختر فيديو" FontSize="10" Foreground="#6E6E73" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="بعد — النتيجة" FontSize="12" FontWeight="SemiBold" Foreground="#D1D1D6"/>
                        <TextBlock x:Name="InlinePreviewOutputStatusText" Text="بانتظار المعالجة" FontSize="10" Foreground="#6E6E73" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Background="#050505">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBlock x:Name="InlinePreviewInputPlaceholder" Text="اختر فيديو لعرض الأصل" Foreground="#6E6E73" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <MediaElement x:Name="InlinePreviewInputMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" IsMuted="True" MediaOpened="InlinePreviewInputMedia_MediaOpened" MediaEnded="InlinePreviewMedia_MediaEnded"/>
                    </Grid>
                    <Border Grid.Column="1" Background="#5A341C" Margin="5,0"/>
                    <Grid Grid.Column="2">
                        <TextBlock x:Name="InlinePreviewOutputPlaceholder" Text="ستظهر النتيجة هنا بعد المعالجة" Foreground="#6E6E73" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <MediaElement x:Name="InlinePreviewOutputMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="InlinePreviewOutputMedia_MediaOpened" MediaEnded="InlinePreviewMedia_MediaEnded"/>
                    </Grid>
                </Grid>

                <Slider x:Name="InlinePreviewSeekBar" Grid.Row="2" Minimum="0" Maximum="100" Margin="0,10,0,4" IsEnabled="False" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="InlinePreviewSeekBar_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="InlinePreviewSeekBar_PreviewMouseLeftButtonUp"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="InlinePreviewPlayButton" Grid.Column="0" Content="▶" Width="36" Height="28" Padding="0" Click="InlinePreviewPlayButton_Click"/>
                    <Button Grid.Column="1" Content="■" Width="36" Height="28" Padding="0" Margin="5,0,0,0" Click="InlinePreviewStopButton_Click"/>
                    <Button x:Name="InlinePreviewMuteButton" Grid.Column="2" Content="🔊" Width="42" Height="28" Padding="0" Margin="5,0,0,0" Click="InlinePreviewMuteButton_Click"/>
                    <TextBlock x:Name="InlinePreviewTimeText" Grid.Column="3" Text="0:00 / 0:00" Foreground="#8E8E93" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- Progress Bar -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Label row: Stage + Percent -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="StageLabel"
                           Text="Ready"
                           Foreground="#8E8E93"
                           FontSize="12"/>
                <TextBlock x:Name="PercentLabel"
                           Text="0%"
                           Foreground="#8E8E93"
                           FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Progress Line -->
            <ProgressBar Grid.Row="1"
                         x:Name="MainProgressBar"
                         Style="{StaticResource VideoProgressStyle}"
                         VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="0"/>

            <Canvas x:Name="ProgressMoodTrack"
                    Grid.Row="1"
                    Height="24"
                    Margin="0,0,0,0"
                    SizeChanged="ProgressMoodTrack_SizeChanged"
                    ClipToBounds="False">
                <Border x:Name="ProgressMoodBubble"
                        Canvas.Left="0"
                        Width="42"
                        Height="24"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Grid Width="34"
                              Height="22">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="RunnerBounceTransform"/>
                            </Grid.RenderTransform>
                            <Image x:Name="RunnerIconImage"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Source="Assets/Emoji/runner.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </Image.RenderTransform>
                            </Image>
                            <Image x:Name="RunnerDashImage"
                                   Width="14"
                                   Height="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Source="Assets/Emoji/dash.png"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock x:Name="ProgressMoodText"
                                   Text="Ready"
                                   Visibility="Collapsed"
                                   Foreground="#D1D1D6"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

        <!-- Owner Rights / Social Links -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <CheckBox x:Name="CompletionSoundCheckBox"
                          Content="Sound"
                          IsChecked="True"
                          Foreground="#8E8E93"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="CompletionSoundCheckBox_Changed"
                          Unchecked="CompletionSoundCheckBox_Changed"/>
                <CheckBox x:Name="SummaryCheckBox"
                          Content="Summary"
                          IsChecked="True"
                          Foreground="#8E8E93"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="SummaryCheckBox_Changed"
                          Unchecked="SummaryCheckBox_Changed"/>
                <TextBlock Text="جميع الحقوق محفوظة A.Hatem T-Zone SYR"
                           Foreground="#8E8E93"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Border Width="104"
                        Height="34"
                        Margin="10,0,4,0"
                        ToolTip="صناعة سورية — Syrian Made">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/SyrianMade.png"
                                    ViewboxUnits="RelativeToBoundingBox"
                                    Viewbox="0.18,0.28,0.66,0.42"
                                    Stretch="Uniform"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="  |  creators.sa/a7atem"
                           Foreground="#D1D1D6"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Store"
                        Tag="https://creators.sa/a7atem"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="YouTube"
                        Tag="https://youtube.com/@bo_7atemm"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="Discord"
                        Tag="https://discord.gg/jF5uNEyg8r"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="Telegram"
                        Tag="https://t.me/a_7atem"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
                <Button Content="TikTok"
                        Tag="https://www.tiktok.com/@bo.7atem"
                        Style="{StaticResource SocialButtonStyle}"
                        Click="SocialButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Buttons Row -->
        <StackPanel Grid.Row="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="TikTokUploadButton"
                    Content="TikTok Upload"
                    Background="#FE2C55"
                    BorderBrush="#FE2C55"
                    Foreground="White"
                    FontWeight="SemiBold"
                    MinWidth="132" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    ToolTip="رفع الفيديو عبر Chrome الحقيقي وTikTok Studio"
                    Click="TikTokUploadButton_Click"/>
            <Button x:Name="StartButton"
                    Content="Start"
                    Style="{StaticResource StartButtonStyle}"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Click="StartButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>
            <Button x:Name="RetryButton"
                    Content="Retry"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="RetryButton_Click"/>
            <Button x:Name="ActivationButton"
                    Content="Activate / Buy"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Click="ActivationButton_Click"/>
            <Button x:Name="UpdateButton"
                    Content="Updates"
                    MinWidth="110" Height="36"
                    Padding="16,0"
                    Click="UpdateButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
